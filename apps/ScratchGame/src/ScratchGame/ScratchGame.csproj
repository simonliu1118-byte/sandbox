<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>ScratchGame</AssemblyName>
    <RootNamespace>ScratchGame</RootNamespace>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\..\VERSION').Trim())</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GeneratedApplicationIcon>$(MSBuildProjectDirectory)\obj\ScratchGame.generated.ico</GeneratedApplicationIcon>
    <ApplicationIcon>$(GeneratedApplicationIcon)</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Assets\ScratchGame-icon-source.png" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <Target Name="GenerateWindowsApplicationIcon" BeforeTargets="PrepareForBuild">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\tools\GenerateWindowsIcon.ps1&quot; -SourcePath &quot;$(MSBuildProjectDirectory)\Assets\ScratchGame-icon-source.png&quot; -OutputPath &quot;$(GeneratedApplicationIcon)&quot;" />
  </Target>
</Project>
