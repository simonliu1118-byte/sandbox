<Window x:Class="ScratchGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="刮刮樂"
        Width="1220" Height="860"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#24120E"
        Loaded="Window_OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="84"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="102"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="26,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#8D171C" Offset="0"/>
                    <GradientStop Color="#621216" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="刮刮樂"
                               FontFamily="Microsoft JhengHei UI"
                               FontSize="31"
                               FontWeight="Bold"
                               Foreground="#FFF4D7"/>
                    <TextBlock Text="刮出好運，樂在每一刻"
                               Margin="2,2,0,0"
                               FontSize="13"
                               Foreground="#E7BE95"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="14" Background="#4A1215" BorderBrush="#A44B40" BorderThickness="1" Padding="16,8" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="目前玩家" FontSize="11" Foreground="#D8A990"/>
                            <TextBlock x:Name="UserSummaryText" Text="尚未載入" FontSize="15" FontWeight="SemiBold" Foreground="#FFF0CF"/>
                        </StackPanel>
                    </Border>
                    <Button Content="使用者" Style="{StaticResource HeaderButton}" Click="UserButton_OnClick"/>
                    <Button Content="⚙  設定" Style="{StaticResource HeaderButton}" Click="SettingsButton_OnClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22,18,22,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Border CornerRadius="20" Background="#3A2118" BorderBrush="#5E3829" BorderThickness="1" Padding="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.32"/>
                </Border.Effect>
                <Viewbox Stretch="Uniform" StretchDirection="Both">
                    <Grid Width="920" Height="560" x:Name="TicketStage">
                        <Border x:Name="TicketPlaceholderPanel" Background="#4A2A1D" CornerRadius="18">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="✦" FontSize="72" Foreground="#D89A35" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TicketPlaceholderText"
                                           Text="按下「新的一張」開始"
                                           Margin="0,14,0,0"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="#F2D8B5"/>
                            </StackPanel>
                        </Border>

                        <Image x:Name="TicketBackgroundImage" Stretch="Fill" Visibility="Collapsed"/>
                        <Canvas x:Name="TicketOverlayCanvas" Width="920" Height="560"/>

                        <Border x:Name="ResultOverlay"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#E81E0B0B"
                                BorderBrush="#F2C05E"
                                BorderThickness="2"
                                CornerRadius="20"
                                Padding="34,20">
                            <StackPanel>
                                <TextBlock x:Name="ResultHeadline"
                                           Text="恭喜中獎"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#FFE5A3"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="ResultAmountText"
                                           Text="$100"
                                           Margin="0,4,0,0"
                                           FontSize="42"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Viewbox>
            </Border>

            <Grid Grid.Row="1" Margin="4,6,4,0">
                <TextBlock x:Name="TicketMetaText"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Foreground="#C9A789"
                           FontSize="12"/>
                <TextBlock x:Name="StatusText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#D3B89E"
                           FontSize="12"/>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#311B14" BorderBrush="#573324" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="＋  新的一張" Width="178" Style="{StaticResource PrimaryActionButton}" Click="NewTicket_OnClick"/>
                <Button Content="✦  全部刮開" Width="178" Style="{StaticResource RevealActionButton}" Click="RevealAll_OnClick"/>
                <Button Content="×  放棄本張" Width="178" Style="{StaticResource DangerActionButton}" Click="Abandon_OnClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
