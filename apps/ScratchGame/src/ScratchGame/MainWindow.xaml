<Window x:Class="ScratchGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ScratchGame.Controls"
        Title="刮刮樂"
        Width="1180" Height="820"
        MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7EE"
        Loaded="Window_OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="88"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#7D1E24" Padding="24,0">
            <Grid>
                <TextBlock Text="刮刮樂"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="UserSummaryText"
                               Foreground="#FFF1DE"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <Button Content="使用者" Click="UserButton_OnClick"/>
                    <Button Content="設定" IsEnabled="False" ToolTip="後續版本補上完整設定頁"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="26,18,26,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="CurrentTicketTitle"
                       Text="尚未選擇彩券"
                       FontSize="25"
                       FontWeight="SemiBold"
                       Foreground="#4B2525"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly">
                <Border Width="930" Height="555"
                        CornerRadius="22"
                        BorderThickness="3"
                        BorderBrush="#D9AE55">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFF0B8" Offset="0"/>
                            <GradientStop Color="#FFE7CC" Offset="0.5"/>
                            <GradientStop Color="#FFF7DE" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid Margin="26">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="90"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="58"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock x:Name="TicketCardName"
                                       Text="選擇一張彩券開始"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       Foreground="#8E2025"
                                       VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="#8E2025"
                                    CornerRadius="22"
                                    Padding="18,8">
                                <TextBlock x:Name="TicketPriceText"
                                           Text="$---"
                                           Foreground="White"
                                           FontSize="22"
                                           FontWeight="Bold"/>
                            </Border>
                        </Grid>

                        <Border Grid.Row="1"
                                Background="#FFFCF5"
                                CornerRadius="16"
                                BorderBrush="#E7CFA2"
                                BorderThickness="1"
                                Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="46"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="RuleHintText"
                                           Text="按下「新的一張」選擇彩券"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="18"
                                           Foreground="#785D45"/>
                                <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid x:Name="GameGrid"
                                          Width="650" Height="330"
                                          Background="#FFFDF8"/>
                                    <controls:ScratchSurface x:Name="ScratchLayer"
                                                             Width="650" Height="330"
                                                             BrushRadius="25"
                                                             CompletionThreshold="0.78"
                                                             Visibility="Collapsed"
                                                             Completed="ScratchLayer_OnCompleted"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <TextBlock x:Name="ResultText"
                                       Text=""
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#A62F2F"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>
            </Viewbox>

            <TextBlock x:Name="StatusText"
                       Grid.Row="2"
                       HorizontalAlignment="Center"
                       Foreground="#77675B"
                       Margin="0,10,0,0"/>
        </Grid>

        <Border Grid.Row="2" Background="#F2E3D1" BorderBrush="#E4CBB0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="新的一張" Width="140" Click="NewTicket_OnClick"/>
                <Button Content="全部刮開" Width="140" Click="RevealAll_OnClick"/>
                <Button Content="放棄本張" Width="140" Click="Abandon_OnClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
