<Window x:Class="ScratchGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="刮刮樂"
        Width="1280" Height="960"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#25100C"
        Loaded="Window_OnLoadedEnhanced"
        Closing="Window_OnClosingEnhanced"
        ContentRendered="Window_OnEnhancementsReady"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="96"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="104"/>
        </Grid.RowDefinitions>

        <!-- Header theme: external artwork only. Dynamic controls stay in WPF. -->
        <Grid Grid.Row="0" Background="#850308" ClipToBounds="True">
            <Image x:Name="TopBarBackgroundImage" Stretch="Fill"/>
            <Grid Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="WalletGrantButton" Style="{StaticResource HeaderGrantButton}" Click="WalletGrant_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="$" FontFamily="Segoe UI" FontWeight="Black" FontSize="17" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="乾爹乾媽給我錢" FontSize="15" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource HeaderButton}" Click="UserButtonEnhanced_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="選擇玩家" FontSize="15" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource HeaderButton}" Click="SettingsButton_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="設定" FontSize="15" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Program-owned separator: never part of Header / Stage artwork. -->
        <Grid Grid.Row="1" IsHitTestVisible="False" Height="4" VerticalAlignment="Stretch">
            <Border Background="#D4A13D"/>
            <Border Height="1" VerticalAlignment="Top" Background="#FFE39A"/>
        </Grid>

        <Grid Grid.Row="2" Background="#8B150B" ClipToBounds="True">
            <Image x:Name="StageBackgroundImage" Stretch="Fill"/>

            <Grid Margin="28,12,28,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <!-- Only ticket-space content belongs in this Viewbox. Program-owned modal text
                     must stay outside so fractional ticket scaling can never blur UI typography. -->
                <Viewbox Stretch="Uniform"
                         StretchDirection="Both"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Margin="16,4">
                    <Grid Width="1080" Height="882" x:Name="TicketStage" LayoutUpdated="TicketStage_Build4LayoutUpdated">
                        <Image x:Name="TicketBackgroundImage"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               SnapsToDevicePixels="True"
                               Visibility="Collapsed"/>

                        <Canvas x:Name="TicketOverlayCanvas"
                                Width="1080" Height="882"
                                Background="Transparent"
                                IsHitTestVisible="{Binding ElementName=TicketBackgroundImage, Path=IsVisible}"
                                PreviewMouseLeftButtonDown="TicketOverlayCanvas_OnPreviewMouseLeftButtonDown"
                                PreviewMouseMove="TicketOverlayCanvas_OnPreviewMouseMove"
                                MouseMove="TicketOverlayCanvas_Build4MouseMove"
                                PreviewMouseLeftButtonUp="TicketOverlayCanvas_OnPreviewMouseLeftButtonUp"
                                MouseEnter="TicketOverlayCanvas_OnMouseEnter"
                                MouseLeave="TicketOverlayCanvas_OnMouseLeave"
                                LayoutUpdated="TicketOverlayCanvas_OnLayoutUpdated"/>

                        <Canvas x:Name="ScratchDebrisLayer" Width="1080" Height="882" IsHitTestVisible="False"/>
                        <Canvas x:Name="CelebrationLayer" Width="1080" Height="882" IsHitTestVisible="False"/>

                        <Canvas x:Name="CoinCursorLayer" Width="1080" Height="882" IsHitTestVisible="False">
                            <Grid x:Name="CoinCursorVisual" Width="92" Height="92" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                <Grid x:Name="CoinIdleVisual">
                                    <Border Width="66" Height="66" CornerRadius="33" BorderBrush="#FFF2B454" BorderThickness="3" Background="#FFE0A12D" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid>
                                            <Ellipse Margin="5" Stroke="#FFF7D988" StrokeThickness="2" Fill="#FFD28A17"/>
                                            <TextBlock Text="$" FontFamily="Segoe UI" FontSize="29" FontWeight="Bold" Foreground="#FFFFE8A8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <Grid x:Name="CoinScratchVisual" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <RotateTransform Angle="-24"/>
                                    </Grid.RenderTransform>
                                    <Ellipse Width="34" Height="80" Fill="#FFD58B18" Stroke="#FFFFD773" StrokeThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Rectangle Width="9" Height="68" RadiusX="4" RadiusY="4" Fill="#FFFFE4A0" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.72"/>
                                    <Ellipse Width="18" Height="66" Stroke="#FFF5B94D" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Canvas>
                    </Grid>
                </Viewbox>

                <!-- Crisp program-owned Stage UI. This layer must never be placed inside TicketStage/Viewbox. -->
                <Grid x:Name="StageUiOverlay"
                      Grid.Row="0"
                      Panel.ZIndex="20"
                      TextOptions.TextFormattingMode="Display"
                      TextOptions.TextRenderingMode="ClearType"
                      SnapsToDevicePixels="True">
                    <Border x:Name="ResultOverlay"
                            Visibility="Collapsed"
                            IsVisibleChanged="ResultOverlay_OnVisibilityChangedExtended"
                            Width="420"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ResultOverlayScale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="ResultOverlayTranslate" X="0" Y="0"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Grid>
                            <Border Background="#F2381711"
                                    BorderBrush="#F1C05A"
                                    BorderThickness="2"
                                    CornerRadius="20"
                                    IsHitTestVisible="False">
                                <Border.Effect>
                                    <DropShadowEffect Color="#160A06" BlurRadius="22" ShadowDepth="7" Opacity="0.55"/>
                                </Border.Effect>
                            </Border>
                            <Border Background="#F2381711"
                                    BorderBrush="#F1C05A"
                                    BorderThickness="2"
                                    CornerRadius="20"
                                    Padding="28,20">
                                <StackPanel>
                                    <TextBlock x:Name="ResultHeadline" Text="恭喜中獎" FontFamily="Microsoft JhengHei UI" FontSize="22" FontWeight="Bold" Foreground="#FFE6A2" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ResultAmountText" Text="$100" Margin="0,4,0,14" FontFamily="Microsoft JhengHei UI" FontSize="36" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="SameAgainButton" Content="再來一張" Style="{StaticResource RevealActionButton}" MinHeight="44" FontFamily="Microsoft JhengHei UI" FontWeight="Bold" FontSize="16" Padding="14,8" Margin="0" BorderThickness="2" Click="SameAgain_OnClick"/>
                                        <Button Grid.Column="2" Content="挑其他款" Style="{StaticResource PrimaryActionButton}" MinHeight="44" FontFamily="Microsoft JhengHei UI" FontWeight="Bold" FontSize="16" Padding="14,8" Margin="0" BorderThickness="2" Click="ChooseOtherTicket_OnClick"/>
                                    </Grid>
                                    <Button Style="{StaticResource ResultUtilityButton}"
                                            HorizontalAlignment="Center"
                                            Margin="0,12,0,0"
                                            Click="HideResultOverlay_OnClick">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="暫時隱藏" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Button x:Name="ResultResumeButton"
                            Visibility="Collapsed"
                            Opacity="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,18"
                            Width="170"
                            Style="{StaticResource ResultPillButton}"
                            RenderTransformOrigin="0.5,0.5"
                            Click="ShowResultOverlay_OnClick">
                        <Button.RenderTransform>
                            <ScaleTransform x:Name="ResultResumeScale" ScaleX="1" ScaleY="1"/>
                        </Button.RenderTransform>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="顯示中獎結果" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border x:Name="ResultTransitionChip"
                            Visibility="Collapsed"
                            Opacity="0"
                            Width="154"
                            Height="38"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#E33A1A14"
                            BorderBrush="#D7A456"
                            BorderThickness="1"
                            CornerRadius="12"
                            IsHitTestVisible="False"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ResultTransitionScale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="ResultTransitionTranslate" X="0" Y="0"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#FFF0C9" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="中獎結果" FontFamily="Microsoft JhengHei UI" FontSize="12" FontWeight="SemiBold" Foreground="#FFF0C9" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="TicketPlaceholderPanel" Margin="16,4" Grid.RowSpan="1" Panel.ZIndex="4">
                    <Border Width="520"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            CornerRadius="26"
                            Padding="34,26"
                            Background="#CDEFD8AE"
                            BorderBrush="#E5D59A45"
                            BorderThickness="2">
                        <Border.Effect>
                            <DropShadowEffect Color="#5B190B" BlurRadius="18" ShadowDepth="5" Opacity="0.32"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="✦" FontSize="62" Foreground="#C78516" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TicketPlaceholderText" Text="還沒有彩券" Margin="0,4,0,0" TextAlignment="Center" FontSize="30" FontWeight="Bold" Foreground="#5B2418"/>
                            <TextBlock Text="挑一張喜歡的彩券，開始今天的手氣。" Margin="0,9,0,20" TextAlignment="Center" FontSize="16" Foreground="#75422E"/>
                            <Button Content="挑一張彩券" Width="220" FontSize="19" Style="{StaticResource PrimaryActionButton}" Click="ChooseTicketFromEmpty_OnClick"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="8,2,8,0">
                    <TextBlock x:Name="TicketMetaText" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#FFF0C8" FontSize="12"/>
                </Grid>
            </Grid>

            <Grid x:Name="WalletGrantOverlay"
                  Visibility="Collapsed"
                  Opacity="0"
                  IsHitTestVisible="False"
                  Panel.ZIndex="50"
                  ClipToBounds="True">
                <Border Background="#66000000"/>
                <Image x:Name="WalletGrantOverlayImage"
                       Stretch="Uniform"
                       Margin="28,10"
                       RenderTransformOrigin="0.5,0.5"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" IsHitTestVisible="False" Height="4" VerticalAlignment="Stretch">
            <Border Background="#D4A13D"/>
            <Border Height="1" VerticalAlignment="Top" Background="#FFE39A"/>
        </Grid>

        <Grid Grid.Row="4" Background="#760006" ClipToBounds="True">
            <Image x:Name="FooterBackgroundImage" Stretch="Fill"/>
            <Grid Margin="24,8,24,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="20"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="350"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="PlayerCardBorder"
                        Grid.Row="0"
                        Grid.Column="0"
                        Width="330"
                        Height="64"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#C12B1713"
                        BorderBrush="#D8A34F"
                        BorderThickness="1.5"
                        CornerRadius="16"
                        Padding="12,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="19" Background="#E7B648" BorderBrush="#FFE6A0" BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock Text="●" FontSize="19" Foreground="#6A2D16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="UserSummaryText"
                                   Grid.Column="1"
                                   Text="尚未載入"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="Microsoft JhengHei UI"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#FFF0CE"
                                   TextWrapping="NoWrap"/>
                    </Grid>
                </Border>

                <StackPanel x:Name="FooterActionsPanel"
                            Grid.Row="0"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Button x:Name="RevealAllButton" Content="✦  全部刮開" Width="220" Style="{StaticResource RevealActionButton}" Click="RevealAllEnhanced_OnClick"/>
                    <Button x:Name="SwapTicketButton" Content="↻  換一張" Width="220" Style="{StaticResource PrimaryActionButton}" Click="SwapTicket_OnClick"/>
                </StackPanel>

                <Button x:Name="PlayStatsFooterButton"
                        Grid.Row="0"
                        Grid.Column="2"
                        Content="遊玩紀錄"
                        Width="150"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource ResultPillButton}"
                        Click="PlayStatsFooter_OnClick"/>

                <TextBlock x:Name="StatusText"
                           Grid.Row="1"
                           Grid.ColumnSpan="3"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           FontFamily="Microsoft JhengHei UI"
                           FontSize="12"
                           Foreground="#FFE5B5"/>
            </Grid>
        </Grid>
    </Grid>
</Window>