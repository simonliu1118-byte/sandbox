<Window x:Class="ScratchGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="刮刮樂"
        Width="1220" Height="860"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#25100C"
        Loaded="Window_OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="96"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="116"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Image x:Name="TopBarBackgroundImage" Stretch="Fill"/>
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="刮刮樂"
                               FontFamily="Microsoft JhengHei UI"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="#FFF2C9">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#5A160F" BlurRadius="6" ShadowDepth="2" Opacity="0.72"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="刮出好運，樂在每一刻"
                               Margin="3,1,0,0"
                               FontSize="13"
                               Foreground="#F0C98A"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="16" Background="#A3200B0B" BorderBrush="#B77A40" BorderThickness="1" Padding="15,8" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="●" Foreground="#F7D77D" FontSize="28" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="目前玩家" FontSize="10" Foreground="#DFAE83"/>
                                <TextBlock x:Name="UserSummaryText" Text="尚未載入" FontSize="15" FontWeight="SemiBold" Foreground="#FFF1CF"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Button Content="👥  使用者" Style="{StaticResource HeaderButton}" Click="UserButton_OnClick"/>
                    <Button Content="⚙  設定" Style="{StaticResource HeaderButton}" Click="SettingsButton_OnClick"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Image x:Name="StageBackgroundImage" Stretch="Fill"/>
            <Grid Margin="34,22,34,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="34"/>
                </Grid.RowDefinitions>

                <Border CornerRadius="24" Background="#301A100C" BorderBrush="#8C693C2C" BorderThickness="1" Padding="14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.42"/>
                    </Border.Effect>
                    <Viewbox Stretch="Uniform" StretchDirection="Both">
                        <Grid Width="1080" Height="657" x:Name="TicketStage">
                            <Border x:Name="TicketPlaceholderPanel" Background="#B83D1A12" CornerRadius="24">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="✦" FontSize="84" Foreground="#DFA43E" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TicketPlaceholderText"
                                               Text="按下「新的一張」開始"
                                               Margin="0,12,0,0"
                                               FontSize="28"
                                               FontWeight="SemiBold"
                                               Foreground="#F5D9AF"/>
                                </StackPanel>
                            </Border>

                            <Image x:Name="TicketBackgroundImage" Stretch="Fill" Visibility="Collapsed"/>
                            <Canvas x:Name="TicketOverlayCanvas"
                                    Width="1080" Height="657"
                                    Background="Transparent"
                                    PreviewMouseLeftButtonDown="TicketOverlayCanvas_OnPreviewMouseLeftButtonDown"
                                    PreviewMouseMove="TicketOverlayCanvas_OnPreviewMouseMove"
                                    PreviewMouseLeftButtonUp="TicketOverlayCanvas_OnPreviewMouseLeftButtonUp"/>

                            <Border x:Name="ResultOverlay"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#F0130907"
                                    BorderBrush="#F1C05A"
                                    BorderThickness="2"
                                    CornerRadius="22"
                                    Padding="38,22">
                                <StackPanel>
                                    <TextBlock x:Name="ResultHeadline"
                                               Text="恭喜中獎"
                                               FontSize="25"
                                               FontWeight="Bold"
                                               Foreground="#FFE6A2"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ResultAmountText"
                                               Text="$100"
                                               Margin="0,4,0,0"
                                               FontSize="44"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Viewbox>
                </Border>

                <Grid Grid.Row="1" Margin="8,5,8,0">
                    <TextBlock x:Name="TicketMetaText" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#EBC48B" FontSize="12"/>
                    <TextBlock x:Name="StatusText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#E5C9A3" FontSize="12"/>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="2">
            <Image x:Name="FooterBackgroundImage" Stretch="Fill"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="🎟  新的一張" Width="192" Style="{StaticResource PrimaryActionButton}" Click="NewTicket_OnClick"/>
                <Button Content="✦  全部刮開" Width="192" Style="{StaticResource RevealActionButton}" Click="RevealAll_OnClick"/>
                <Button Content="×  放棄本張" Width="192" Style="{StaticResource DangerActionButton}" Click="Abandon_OnClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
