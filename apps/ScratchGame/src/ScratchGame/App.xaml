<Application x:Class="ScratchGame.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Style x:Key="ActionButtonBase" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Microsoft JhengHei UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="Margin" Value="7,0"/>
            <Setter Property="MinHeight" Value="54"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                            <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.38"/></Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.91"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.76"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.42"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}"><Setter Property="Background" Value="#B51E24"/><Setter Property="BorderBrush" Value="#F2A93E"/></Style>
        <Style x:Key="RevealActionButton" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}"><Setter Property="Background" Value="#E29B20"/><Setter Property="BorderBrush" Value="#FFE49D"/><Setter Property="Foreground" Value="#3A2109"/></Style>
        <Style x:Key="DangerActionButton" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}"><Setter Property="Background" Value="#514C53"/><Setter Property="BorderBrush" Value="#938C95"/></Style>

        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/><Setter Property="FontFamily" Value="Microsoft JhengHei UI"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="17,9"/><Setter Property="Margin" Value="7,0"/><Setter Property="MinHeight" Value="46"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#871A1919"/><Setter Property="BorderBrush" Value="#C77944"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/><Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#A12B1A18"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.82"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}"><Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="18,8"/><Setter Property="Margin" Value="5,0"/><Setter Property="Background" Value="#8F1C21"/><Setter Property="BorderBrush" Value="#D79B46"/></Style>
        <Style x:Key="DialogSecondaryButton" TargetType="Button" BasedOn="{StaticResource DialogButton}"><Setter Property="Background" Value="#4F3832"/><Setter Property="BorderBrush" Value="#806056"/></Style>
    </Application.Resources>
</Application>
