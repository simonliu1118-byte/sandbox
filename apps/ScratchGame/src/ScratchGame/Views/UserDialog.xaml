<Window x:Class="ScratchGame.Views.UserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="使用者"
        Width="620" Height="480"
        WindowStartupLocation="CenterOwner"
        Background="#FFF7EE">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="選擇使用者" FontSize="26" FontWeight="SemiBold" Foreground="#5B1D1D"/>

        <ListBox x:Name="UserListBox"
                 Grid.Row="1"
                 Margin="0,18,0,16"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Foreground="#6F6257">
                            <Run Text="損益 "/>
                            <Run Text="{Binding Net, StringFormat={}{0:N0}}"/>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NewUserNameTextBox"
                     Height="38"
                     VerticalContentAlignment="Center"
                     FontSize="15"
                     Padding="10,0"
                     ToolTip="輸入新使用者名稱"/>
            <Button Grid.Column="1" Content="新增使用者" Width="120" Click="AddUser_OnClick"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="100" Click="Cancel_OnClick"/>
            <Button Content="切換" Width="110" IsDefault="True" Click="Select_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
