<Window x:Class="ScratchGame.Views.UserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="使用者"
        Width="700" Height="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#2A120E">
    <Grid>
        <Image x:Name="DialogBackgroundImage" Stretch="Fill"/>
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="使用者" FontSize="28" FontWeight="Bold" Foreground="#FFE6A6"/>
                <TextBlock Text="每位玩家的投入、兌獎與損益各自獨立保存" Margin="0,4,0,0" Foreground="#D8B392" FontSize="13"/>
            </StackPanel>

            <ListBox x:Name="UserListBox"
                     Grid.Row="1"
                     Margin="0,20,0,16"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,10"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#B3341B16" BorderBrush="#7D5A4034" BorderThickness="1" CornerRadius="14" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName, Mode=OneWay}" FontSize="19" FontWeight="SemiBold" Foreground="#FFF1CF"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Foreground="#CDAE91" FontSize="12" Text="投入 $"/>
                                        <TextBlock Foreground="#CDAE91" FontSize="12" Text="{Binding TotalSpent, Mode=OneWay, StringFormat={}{0:N0}}"/>
                                        <TextBlock Foreground="#876B5B" FontSize="12" Text="　｜　"/>
                                        <TextBlock Foreground="#CDAE91" FontSize="12" Text="兌獎 $"/>
                                        <TextBlock Foreground="#CDAE91" FontSize="12" Text="{Binding TotalRedeemed, Mode=OneWay, StringFormat={}{0:N0}}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="損益" HorizontalAlignment="Right" Foreground="#B99376" FontSize="11"/>
                                    <TextBlock Text="{Binding Net, Mode=OneWay, StringFormat={}{0:N0}}" FontSize="20" FontWeight="Bold" Foreground="#FFD46C" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="2" Background="#8A241713" CornerRadius="12" BorderBrush="#73534235" BorderThickness="1" Padding="12" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewUserNameTextBox" Height="40" VerticalContentAlignment="Center" FontSize="15" Padding="10,0" ToolTip="輸入新使用者名稱"/>
                    <Button Grid.Column="1" Content="新增使用者" Width="126" Style="{StaticResource DialogButton}" Click="AddUser_OnClick"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="108" Style="{StaticResource DialogSecondaryButton}" Click="Cancel_OnClick"/>
                <Button Content="切換使用者" Width="132" Style="{StaticResource DialogButton}" IsDefault="True" Click="Select_OnClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
