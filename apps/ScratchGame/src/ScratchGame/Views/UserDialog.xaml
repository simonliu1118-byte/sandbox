<Window x:Class="ScratchGame.Views.UserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="使用者"
        Width="760" Height="650"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="InlineGlyphButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="7,0,0,0"/>
            <Setter Property="FontFamily" Value="Microsoft JhengHei UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F3C86C"/>
            <Setter Property="Background" Value="#35251B17"/>
            <Setter Property="BorderBrush" Value="#8A6C4B37"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#69402A1F"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#D59A54"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.78"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#FFF0D0"/>
            <Setter Property="CaretBrush" Value="#FFD05A"/>
            <Setter Property="Background" Value="#25110E"/>
            <Setter Property="BorderBrush" Value="#75503E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="FontFamily" Value="Microsoft JhengHei UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SelectionBrush" Value="#8F6229"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#D8A24D"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UserListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="#402019" BorderBrush="#6A4739" BorderThickness="1" CornerRadius="13" Padding="16,13">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#4A261E"/><Setter TargetName="Card" Property="BorderBrush" Value="#8F6448"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="#553020"/><Setter TargetName="Card" Property="BorderBrush" Value="#D29A4A"/><Setter TargetName="Card" Property="BorderThickness" Value="1.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="22" BorderBrush="#B87B40" BorderThickness="1.5" Background="#351610" SnapsToDevicePixels="True">
        <Grid Margin="30,24,30,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="66"/>
                <RowDefinition Height="54"/>
            </Grid.RowDefinitions>
            <Image x:Name="DialogBackgroundImage" Visibility="Collapsed"/>

            <StackPanel>
                <TextBlock Text="使用者" FontFamily="Microsoft JhengHei UI" FontSize="29" FontWeight="Bold" Foreground="#FFE6A6"/>
                <TextBlock Text="每位玩家的錢包與遊玩統計各自獨立保存" Margin="1,5,0,0" Foreground="#D8B392" FontSize="13"/>
            </StackPanel>

            <ListBox x:Name="UserListBox"
                     Grid.Row="1"
                     Margin="0,10,0,12"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ItemContainerStyle="{StaticResource UserListItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                                <Grid MinHeight="38">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{Binding DisplayName}" FontFamily="Microsoft JhengHei UI" FontSize="19" FontWeight="SemiBold" Foreground="#FFF1CF" VerticalAlignment="Center"/>
                                        <Button Content="✎" Style="{StaticResource InlineGlyphButton}" ToolTip="修改名稱" Click="EditName_OnClick"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
                                        </StackPanel.Style>
                                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Width="285" Height="34" Style="{StaticResource ThemedTextBox}" KeyDown="EditNameTextBox_OnKeyDown"/>
                                        <Button Content="✓" Style="{StaticResource InlineGlyphButton}" ToolTip="儲存名稱" Click="SaveName_OnClick"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="18,0,0,0">
                                    <TextBlock Text="錢包" HorizontalAlignment="Right" Foreground="#B99376" FontSize="11"/>
                                    <TextBlock Text="{Binding WalletText}" FontSize="21" FontWeight="Bold" Foreground="#FFD46C" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="#614235" Margin="0,9,0,9"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="累計刮卡" Foreground="#A98670" FontSize="10"/>
                                    <TextBlock Text="{Binding CompletedTicketCount, StringFormat={}{0:N0} 張}" Foreground="#F6DFC0" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="中獎張數" Foreground="#A98670" FontSize="10"/>
                                    <TextBlock Text="{Binding WinCount, StringFormat={}{0:N0} 張}" Foreground="#F6DFC0" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="勝率" Foreground="#A98670" FontSize="10"/>
                                    <TextBlock Text="{Binding WinRateText}" Foreground="#F6DFC0" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="最大獎金" Foreground="#A98670" FontSize="10"/>
                                    <TextBlock Text="{Binding MaxPrizeText}" Foreground="#FFE098" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="累計投入" Foreground="#A98670" FontSize="10"/>
                                    <TextBlock Text="{Binding TotalSpentText}" Foreground="#DCC6AF" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="累計中獎" Foreground="#A98670" FontSize="10"/>
                                    <TextBlock Text="{Binding TotalRedeemedText}" Foreground="#DCC6AF" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="總損益" Foreground="#A98670" FontSize="10"/>
                                    <TextBlock Text="{Binding NetText}" Foreground="#FFD46C" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,9,0,0" Foreground="#9F806B" FontSize="11">
                                <Run Text="資助 "/><Run Text="{Binding GrantCount, StringFormat={}{0:N0}}"/><Run Text=" 次　｜　累計 "/><Run Text="{Binding GrantTotalText}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="2" Margin="0,3,0,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="126"/></Grid.ColumnDefinitions>
                <TextBox x:Name="NewUserNameTextBox" Height="42" Style="{StaticResource ThemedTextBox}" ToolTip="輸入新使用者名稱"/>
                <Button Grid.Column="2" Content="新增使用者" Width="126" Style="{StaticResource DialogButton}" Click="AddUser_OnClick"/>
            </Grid>

            <Grid Grid.Row="3" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="遊玩統計從目前版本開始累積，不保存逐張彩券歷史。" VerticalAlignment="Center" Foreground="#9B7D69" FontSize="11"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Width="108" Style="{StaticResource DialogSecondaryButton}" Click="Cancel_OnClick"/>
                    <Button Content="切換使用者" Width="132" Style="{StaticResource DialogButton}" IsDefault="True" Click="Select_OnClick"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
