<Window x:Class="ScratchGame.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定選單"
        Width="1060" Height="800"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        Loaded="Window_OnLoaded"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="ThemedScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="14"/>
            <Setter Property="MinWidth" Value="14"/>
            <Setter Property="Background" Value="#21100D"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Width="14" Background="#21100D" CornerRadius="7" Padding="3,2">
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Cursor="Hand" MinHeight="34">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#AA7136" BorderBrush="#E4B35E" BorderThickness="1" CornerRadius="5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Visible"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Grid.Column="0"
                                                    Margin="0,0,8,0"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Style="{StaticResource ThemedScrollBar}"
                                       Orientation="Vertical"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="Visible"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowActionButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="68"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontFamily" Value="Microsoft JhengHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFF2CC"/>
            <Setter Property="Background" Value="#65432E"/>
            <Setter Property="BorderBrush" Value="#A9784C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#795137"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#D5A25E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowBatchButton" TargetType="Button" BasedOn="{StaticResource RowActionButton}">
            <Setter Property="MinWidth" Value="106"/>
            <Setter Property="Background" Value="#9D2026"/>
            <Setter Property="BorderBrush" Value="#DBA152"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="RowInfoButton" TargetType="Button" BasedOn="{StaticResource RowActionButton}">
            <Setter Property="MinWidth" Value="58"/>
            <Setter Property="Background" Value="#3B241C"/>
            <Setter Property="BorderBrush" Value="#B88655"/>
            <Setter Property="Foreground" Value="#FFE1A0"/>
        </Style>

        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft JhengHei UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#B99176"/>
        </Style>

        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft JhengHei UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFF0CF"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border CornerRadius="22"
                BorderBrush="#B87B40"
                BorderThickness="1.5"
                Background="#351610"
                SnapsToDevicePixels="True">
            <Grid Margin="30,22,24,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="64"/>
                </Grid.RowDefinitions>

                <TextBlock Text="設定選單"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           FontFamily="Microsoft JhengHei UI"
                           FontSize="31"
                           FontWeight="Bold"
                           Foreground="#FFE6A6"/>

                <Border Grid.Row="1"
                        Background="#25100C"
                        BorderBrush="#654034"
                        BorderThickness="1"
                        CornerRadius="14"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="#5A251D"
                                BorderBrush="#714536"
                                BorderThickness="0,0,0,1"
                                CornerRadius="13,13,0,0"
                                ClipToBounds="True">
                            <Grid Margin="0,0,26,0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.55*"/>
                                    <ColumnDefinition Width="0.62*"/>
                                    <ColumnDefinition Width="0.68*"/>
                                    <ColumnDefinition Width="1.0*"/>
                                    <ColumnDefinition Width="0.72*"/>
                                    <ColumnDefinition Width="278"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="彩券" Margin="14,0,6,0" Foreground="#FFE2A1" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="面額" Foreground="#FFE2A1" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="中獎率" Foreground="#FFE2A1" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="玩法" Foreground="#FFE2A1" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="批次" Foreground="#FFE2A1" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="操作" Foreground="#FFE2A1" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      Style="{StaticResource ThemedScrollViewer}"
                                      PanningMode="VerticalOnly">
                            <ItemsControl x:Name="TicketItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent"
                                                BorderBrush="#5D392F"
                                                BorderThickness="0,0,0,1">
                                            <Grid MinHeight="56">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.55*"/>
                                                    <ColumnDefinition Width="0.62*"/>
                                                    <ColumnDefinition Width="0.68*"/>
                                                    <ColumnDefinition Width="1.0*"/>
                                                    <ColumnDefinition Width="0.72*"/>
                                                    <ColumnDefinition Width="278"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Margin="14,0,6,0"
                                                           Text="{Binding Ticket.DisplayName}"
                                                           FontSize="14"
                                                           Foreground="#F7E4C6"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding PriceText}" FontSize="14" Foreground="#F7E4C6" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding WinRateText}" FontSize="14" Foreground="#F7E4C6" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Ticket.RuleDisplayName}" FontSize="14" Foreground="#F7E4C6" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Ticket.BatchText}" FontSize="14" Foreground="#F7E4C6" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="5"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <Button Content="資訊" Tag="{Binding}" Style="{StaticResource RowInfoButton}" Click="InfoRow_OnClick"/>
                                                    <Button Content="發行下一批" Tag="{Binding}" Style="{StaticResource RowBatchButton}" Click="StartBatchRow_OnClick"/>
                                                    <Button Content="隱藏" Tag="{Binding}" Style="{StaticResource RowActionButton}" Click="HideRow_OnClick"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,14,0,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="匯入 ScratchPack"
                                Width="170"
                                Style="{StaticResource DialogButton}"
                                Click="Import_OnClick"/>
                        <Button Content="已隱藏 Pack"
                                Width="138"
                                Margin="10,0,0,0"
                                Style="{StaticResource DialogSecondaryButton}"
                                Click="HiddenPacks_OnClick"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="立即備份"
                                Width="120"
                                Style="{StaticResource DialogSecondaryButton}"
                                Click="Backup_OnClick"/>
                        <Button Content="關閉"
                                Width="100"
                                Margin="10,0,0,0"
                                Style="{StaticResource DialogSecondaryButton}"
                                Click="Close_OnClick"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Popup x:Name="TicketInfoPopup"
               Placement="Bottom"
               VerticalOffset="8"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Width="400"
                    MaxHeight="560"
                    Padding="18"
                    CornerRadius="16"
                    Background="#3A1B15"
                    BorderBrush="#C28A49"
                    BorderThickness="1.5">
                <Border.Effect>
                    <DropShadowEffect Color="#120806" BlurRadius="22" ShadowDepth="7" Opacity="0.55"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Ticket.DisplayName}"
                                       FontFamily="Microsoft JhengHei UI"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#FFE6A6"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding SourceText}" FontSize="12" Foreground="#C69B7D"/>
                                <TextBlock Text="  •  " FontSize="12" Foreground="#8E6D5B"/>
                                <TextBlock Text="{Binding Ticket.RuleDisplayName}" FontSize="12" Foreground="#C69B7D"/>
                                <TextBlock Text="  •  " FontSize="12" Foreground="#8E6D5B"/>
                                <TextBlock Text="{Binding Ticket.BatchText}" FontSize="12" Foreground="#C69B7D"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="×"
                                Width="30" Height="30" MinWidth="30" Padding="0"
                                Margin="12,0,0,0"
                                FontSize="18"
                                Style="{StaticResource RowInfoButton}"
                                Click="CloseInfoPopup_OnClick"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="面額" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="{Binding PriceText}" Style="{StaticResource InfoValue}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="中獎率" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="{Binding WinRateText}" Style="{StaticResource InfoValue}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="剩餘張數" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="{Binding RemainingText}" Style="{StaticResource InfoValue}" Foreground="#FFE29A"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="總發行" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="{Binding IssueSizeText}" Style="{StaticResource InfoValue}" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="每本" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="{Binding TicketsPerBookText}" Style="{StaticResource InfoValue}" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="總本數" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="{Binding BookCountText}" Style="{StaticResource InfoValue}" FontSize="14"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="3" Margin="0,16,0,0">
                        <TextBlock Text="獎池分配"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#FFE1A0"
                                   Margin="0,0,0,6"/>
                        <Border BorderBrush="#5E392E" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Background="#51291F">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="獎金" Padding="10,6" Foreground="#E8C493"/>
                                    <TextBlock Grid.Column="1" Text="發行張數" Padding="10,6" Foreground="#E8C493"/>
                                    <TextBlock Grid.Column="2" Text="剩餘" Padding="10,6" Foreground="#E8C493"/>
                                </Grid>
                                <ScrollViewer Grid.Row="1" MaxHeight="145" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding PrizeRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Background="#301712">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.2*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding AmountText}" Padding="10,5" Foreground="#FFF0D4"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding InitialText}" Padding="10,5" Foreground="#E9D4BC"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding RemainingText}" Padding="10,5" Foreground="#E9D4BC"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="4" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding UninstallHint}"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="#A9856E"
                                   FontSize="11"/>
                        <Button Grid.Column="1"
                                Content="解除安裝 Pack"
                                IsEnabled="{Binding CanUninstall}"
                                Width="142"
                                Style="{StaticResource DialogSecondaryButton}"
                                Click="UninstallInfo_OnClick"/>
                    </Grid>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>