<Window x:Class="ScratchGame.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定"
        Width="1060" Height="800"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        Loaded="Window_OnLoaded"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="ThemedScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="14"/>
            <Setter Property="MinWidth" Value="14"/>
            <Setter Property="Background" Value="#28130F"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Width="14" Background="#28130F" CornerRadius="7" Padding="3,2">
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Cursor="Hand" MinHeight="34">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#B47738" BorderBrush="#E0B061" BorderThickness="1" CornerRadius="5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Visible"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Grid.Column="0"
                                                    Margin="0,0,8,0"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Style="{StaticResource ThemedScrollBar}"
                                       Orientation="Vertical"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowStatusButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="82"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontFamily" Value="Microsoft JhengHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFF2CC"/>
            <Setter Property="Background" Value="#8C5C2C"/>
            <Setter Property="BorderBrush" Value="#D5A259"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.88"/></Trigger>
                            <DataTrigger Binding="{Binding Ticket.Enabled}" Value="False">
                                <Setter Property="Background" Value="#4E403A"/>
                                <Setter Property="BorderBrush" Value="#79655C"/>
                                <Setter Property="Foreground" Value="#D7CBC3"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowBatchButton" TargetType="Button" BasedOn="{StaticResource RowStatusButton}">
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="Background" Value="#9D2026"/>
            <Setter Property="BorderBrush" Value="#DBA152"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="22"
            BorderBrush="#B87B40"
            BorderThickness="1.5"
            Background="#32140F"
            SnapsToDevicePixels="True">
        <Grid Margin="30,22,24,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="84"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="設定" FontSize="31" FontWeight="Bold" Foreground="#FFE6A6"/>
                <TextBlock Text="彩券、批次與資料管理" Margin="1,6,0,0" Foreground="#D8B392" FontSize="13"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="#25100C"
                    BorderBrush="#654034"
                    BorderThickness="1"
                    CornerRadius="14"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#5A251D" BorderBrush="#714536" BorderThickness="0,0,0,1" Padding="14,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.8*"/>
                                <ColumnDefinition Width="0.65*"/>
                                <ColumnDefinition Width="0.75*"/>
                                <ColumnDefinition Width="1.05*"/>
                                <ColumnDefinition Width="0.78*"/>
                                <ColumnDefinition Width="94"/>
                                <ColumnDefinition Width="122"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="彩券" Foreground="#FFE2A1" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="面額" Foreground="#FFE2A1" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="中獎率" Foreground="#FFE2A1" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="玩法" Foreground="#FFE2A1" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="批次" Foreground="#FFE2A1" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="狀態" Foreground="#FFE2A1" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="批次操作" Foreground="#FFE2A1" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" Style="{StaticResource ThemedScrollViewer}" PanningMode="VerticalOnly">
                        <ItemsControl x:Name="TicketItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid Tag="{Binding}"
                                              Background="#392019"
                                              MinHeight="54"
                                              Cursor="Hand"
                                              MouseLeftButtonUp="TicketRow_OnClick">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.8*"/>
                                                <ColumnDefinition Width="0.65*"/>
                                                <ColumnDefinition Width="0.75*"/>
                                                <ColumnDefinition Width="1.05*"/>
                                                <ColumnDefinition Width="0.78*"/>
                                                <ColumnDefinition Width="94"/>
                                                <ColumnDefinition Width="122"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="8" BorderBrush="#604035" BorderThickness="0,0,0,1"/>
                                            <TextBlock Margin="14,0,6,0" Text="{Binding Ticket.DisplayName}" FontSize="14" Foreground="#F7E4C6" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding PriceText}" FontSize="14" Foreground="#F7E4C6" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding WinRateText}" FontSize="14" Foreground="#F7E4C6" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Ticket.RuleDisplayName}" FontSize="14" Foreground="#F7E4C6" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Ticket.BatchText}" FontSize="14" Foreground="#F7E4C6" VerticalAlignment="Center"/>
                                            <Button Grid.Column="5"
                                                    Content="{Binding Ticket.StatusText}"
                                                    Tag="{Binding}"
                                                    Style="{StaticResource RowStatusButton}"
                                                    Click="ToggleEnabledRow_OnClick"/>
                                            <Button Grid.Column="6"
                                                    Content="發行新一批"
                                                    Tag="{Binding}"
                                                    Style="{StaticResource RowBatchButton}"
                                                    Click="StartBatchRow_OnClick"/>
                                            <TextBlock Grid.Column="7" Text="{Binding ExpandGlyph}" FontSize="18" Foreground="#E8B65D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}"
                                                Background="#2B1510"
                                                BorderBrush="#654034"
                                                BorderThickness="0,0,0,1"
                                                Padding="20,16,20,18">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="總發行" Foreground="#BB9478" FontSize="11"/>
                                                        <TextBlock Text="{Binding IssueSizeText}" Foreground="#FFF0CF" FontSize="17" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="每本" Foreground="#BB9478" FontSize="11"/>
                                                        <TextBlock Text="{Binding TicketsPerBookText}" Foreground="#FFF0CF" FontSize="17" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="總本數" Foreground="#BB9478" FontSize="11"/>
                                                        <TextBlock Text="{Binding BookCountText}" Foreground="#FFF0CF" FontSize="17" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3">
                                                        <TextBlock Text="剩餘張數" Foreground="#BB9478" FontSize="11"/>
                                                        <TextBlock Text="{Binding RemainingText}" Foreground="#FFE29A" FontSize="17" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="獎池分配" FontSize="14" FontWeight="SemiBold" Foreground="#FFE1A0" Margin="0,0,0,7"/>
                                                <Grid Background="#4A261D">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.2*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="獎金" Padding="10,6" Foreground="#E8C493"/>
                                                    <TextBlock Grid.Column="1" Text="發行張數" Padding="10,6" Foreground="#E8C493"/>
                                                    <TextBlock Grid.Column="2" Text="剩餘" Padding="10,6" Foreground="#E8C493"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding PrizeRows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Background="#321913">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="1.2*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding AmountText}" Padding="10,5" Foreground="#FFF0D4"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding InitialText}" Padding="10,5" Foreground="#E9D4BC"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding RemainingText}" Padding="10,5" Foreground="#E9D4BC"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Button Content="刪除未發行彩券"
                                                        Tag="{Binding}"
                                                        IsEnabled="{Binding CanDelete}"
                                                        Width="150"
                                                        Margin="0,14,0,0"
                                                        HorizontalAlignment="Left"
                                                        Style="{StaticResource DialogSecondaryButton}"
                                                        Click="DeleteRow_OnClick"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,14,0,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="匯入 ScratchPack"
                        Width="170"
                        HorizontalAlignment="Left"
                        Style="{StaticResource DialogButton}"
                        Click="Import_OnClick"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="立即備份" Width="120" Style="{StaticResource DialogSecondaryButton}" Click="Backup_OnClick"/>
                    <Button Content="關閉" Width="100" Style="{StaticResource DialogSecondaryButton}" Click="Close_OnClick"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
