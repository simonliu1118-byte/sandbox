<Window x:Class="ScratchGame.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定"
        Width="930" Height="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        Loaded="Window_OnLoaded">
    <Border CornerRadius="22" BorderBrush="#B87B40" BorderThickness="1" Background="#2A120E" SnapsToDevicePixels="True">
        <Grid>
            <Image x:Name="DialogBackgroundImage" Stretch="Fill" Opacity="0.92"/>
            <Grid Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel>
                        <TextBlock Text="設定" FontSize="30" FontWeight="Bold" Foreground="#FFE6A6"/>
                        <TextBlock Text="彩券、批次與資料管理" Margin="0,4,0,0" Foreground="#D8B392" FontSize="13"/>
                    </StackPanel>
                    <Button Content="×" Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Style="{StaticResource DialogSecondaryButton}" Padding="0" Margin="0" Click="Close_OnClick"/>
                </Grid>

                <Border Grid.Row="1" Margin="0,20,0,18" Background="#A72A1713" BorderBrush="#73534235" BorderThickness="1" CornerRadius="14" Padding="10">
                    <DataGrid x:Name="TicketGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowBackground="#3A211B"
                              AlternatingRowBackground="#47261E"
                              Foreground="#F7E4C6"
                              Background="Transparent"
                              BorderThickness="0"
                              HorizontalGridLinesBrush="#5C3D31"
                              VerticalGridLinesBrush="#5C3D31"
                              FontSize="13">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#5A251D"/>
                                <Setter Property="Foreground" Value="#FFE2A1"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderBrush" Value="#714536"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Height" Value="38"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="彩券" Binding="{Binding DisplayName}" Width="*"/>
                            <DataGridTextColumn Header="面額" Binding="{Binding Price, StringFormat={}${0:N0}}" Width="90"/>
                            <DataGridTextColumn Header="中獎率" Binding="{Binding PublishedWinRate, StringFormat={}{0:P2}}" Width="95"/>
                            <DataGridTextColumn Header="玩法" Binding="{Binding RuleId}" Width="140"/>
                            <DataGridTextColumn Header="目前批次" Binding="{Binding ActiveBatchNumber}" Width="85"/>
                            <DataGridCheckBoxColumn Header="啟用" Binding="{Binding Enabled}" Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Grid Grid.Row="2">
                    <WrapPanel HorizontalAlignment="Left">
                        <Button Content="匯入 ScratchPack" Style="{StaticResource DialogSecondaryButton}" Click="Import_OnClick"/>
                        <Button Content="發行新一批" Style="{StaticResource DialogButton}" Click="NewBatch_OnClick"/>
                        <Button Content="啟用 / 停用" Style="{StaticResource DialogSecondaryButton}" Click="ToggleEnabled_OnClick"/>
                        <Button Content="刪除未發行" Style="{StaticResource DialogSecondaryButton}" Click="Delete_OnClick"/>
                        <Button Content="立即備份" Style="{StaticResource DialogSecondaryButton}" Click="Backup_OnClick"/>
                    </WrapPanel>
                    <Button Content="關閉" Width="100" HorizontalAlignment="Right" Style="{StaticResource DialogSecondaryButton}" Click="Close_OnClick"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
