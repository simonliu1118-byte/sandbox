<Window x:Class="ScratchGame.Views.NewTicketDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新的一張"
        Width="860" Height="640"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#2A120E">
    <Grid>
        <Image x:Name="DialogBackgroundImage" Stretch="Fill"/>
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="選擇一張彩券" FontSize="30" FontWeight="Bold" Foreground="#FFE6A6"/>
                <TextBlock Text="挑一張喜歡的票開始刮獎" Margin="0,4,0,0" Foreground="#D8B392" FontSize="13"/>
            </StackPanel>

            <Border Grid.Row="1" Margin="0,18,0,16" Background="#8A241713" BorderBrush="#73534235" BorderThickness="1" CornerRadius="12" Padding="12,9">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="面額" VerticalAlignment="Center" FontSize="15" Foreground="#F4D9B0" Margin="0,0,12,0"/>
                    <ComboBox x:Name="PriceComboBox" Width="170" Height="36" SelectionChanged="PriceComboBox_OnSelectionChanged"/>
                </StackPanel>
            </Border>

            <ListBox x:Name="TicketListBox" Grid.Row="2" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,12"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#C9311D17" BorderBrush="#88614134" BorderThickness="1" CornerRadius="16" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="214" Height="130" Background="#24110D" CornerRadius="10" ClipToBounds="True">
                                    <Image Source="{Binding ThumbnailPath, Mode=OneWay}" Stretch="Uniform"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="18,8,16,8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Ticket.DisplayName, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="#FFF0CF"/>
                                    <TextBlock Margin="0,8,0,0" Foreground="#D2AE8E" FontSize="14">
                                        <Run Text="面額 $"/><Run Text="{Binding Ticket.Price, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,6,0,0" Text="有限票池 · 批次發行" Foreground="#9F806D" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0">
                                    <TextBlock Text="發行中獎率" HorizontalAlignment="Right" Foreground="#B99376" FontSize="12"/>
                                    <TextBlock Text="{Binding Ticket.PublishedWinRate, Mode=OneWay, StringFormat={}{0:P2}}" FontSize="25" FontWeight="Bold" Foreground="#FFD363" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="取消" Width="110" Style="{StaticResource DialogSecondaryButton}" Click="Cancel_OnClick"/>
                <Button Content="開始刮獎" Width="140" Style="{StaticResource DialogButton}" IsDefault="True" Click="Start_OnClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
