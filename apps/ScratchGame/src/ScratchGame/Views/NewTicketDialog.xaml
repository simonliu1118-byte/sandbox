<Window x:Class="ScratchGame.Views.NewTicketDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新的一張"
        Width="720" Height="520"
        MinWidth="620" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#FFF7EE">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="選擇一張彩券"
                   FontSize="28"
                   FontWeight="SemiBold"
                   Foreground="#5B1D1D"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,16">
            <TextBlock Text="面額" VerticalAlignment="Center" FontSize="16" Margin="0,0,12,0"/>
            <ComboBox x:Name="PriceComboBox"
                      Width="160" Height="36"
                      SelectionChanged="PriceComboBox_OnSelectionChanged"/>
        </StackPanel>

        <ListBox x:Name="TicketListBox"
                 Grid.Row="2"
                 BorderThickness="0"
                 Background="Transparent"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White"
                            BorderBrush="#E3CBAF"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#4A2020"/>
                                <TextBlock Margin="0,7,0,0" Foreground="#675B52">
                                    <Run Text="面額 $"/>
                                    <Run Text="{Binding Price, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="中獎率" HorizontalAlignment="Right" Foreground="#7B6A5D"/>
                                <TextBlock Text="{Binding PublishedWinRate, StringFormat={}{0:P2}}"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           Foreground="#A62F2F"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Width="100" Click="Cancel_OnClick"/>
            <Button Content="開始刮獎" Width="130" IsDefault="True" Click="Start_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
