<Window x:Class="ScratchGame.Views.NewTicketDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="挑選彩券"
        Width="1060" Height="760"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Background" Value="#21100D"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Width="13" Background="#21100D" CornerRadius="7" Padding="3,2">
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" Opacity="0"/></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb Cursor="Hand" MinHeight="34"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#AA7136" BorderBrush="#E4B35E" BorderThickness="1" CornerRadius="5"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" Opacity="0"/></Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PriceNoteItem" TargetType="ListBoxItem">
            <Setter Property="Width" Value="101"/>
            <Setter Property="Height" Value="66"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="IsEnabled" Value="{Binding HasTickets}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="SelectionChrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="12" Padding="3" Margin="2">
                            <Border x:Name="Note" CornerRadius="7" BorderBrush="#98612F" BorderThickness="1" Background="#3A2118">
                                <Grid Margin="7,4">
                                    <Ellipse Width="17" Height="17" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#5B2E1C" Stroke="#C98B3D" StrokeThickness="1"/>
                                    <TextBlock Text="✦" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,-1,0,0" Foreground="#D9A44F" FontSize="9"/>
                                    <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FBE5B8" FontFamily="Microsoft JhengHei UI" FontWeight="SemiBold" FontSize="14"/>
                                </Grid>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionChrome" Property="BorderBrush" Value="#FFD66A"/>
                                <Setter TargetName="SelectionChrome" Property="Background" Value="#26F2B54C"/>
                                <Setter TargetName="Note" Property="BorderBrush" Value="#E6A94F"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectionChrome" Property="Background" Value="#18FFFFFF"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SelectionChrome" Property="Opacity" Value="0.28"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TicketCardItem" TargetType="ListBoxItem">
            <Setter Property="Width" Value="430"/>
            <Setter Property="Height" Value="142"/>
            <Setter Property="Margin" Value="10,8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="#3A1A14" BorderBrush="#6B4538" BorderThickness="1" CornerRadius="14" Padding="12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#48241A"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="#B17A43"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#6A544F"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="#FFD05A"/>
                                <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="22" BorderBrush="#B87B40" BorderThickness="1.4" Background="#351610" SnapsToDevicePixels="True">
        <Grid Margin="30,24,30,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="86"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="66"/>
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="挑選彩券" FontFamily="Microsoft JhengHei UI" FontSize="30" FontWeight="Bold" Foreground="#FFE6A6"/>
                <TextBlock Text="選一張喜歡的票，開始今天的手氣。" Margin="1,5,0,0" Foreground="#D8B392" FontSize="13"/>
            </StackPanel>

            <Grid Grid.Row="1" VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="面額" VerticalAlignment="Center" FontSize="16" Foreground="#F4D9B0"/>
                <ListBox x:Name="PriceFilterListBox"
                         Grid.Column="1"
                         SelectionChanged="PriceFilterListBox_OnSelectionChanged"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0,0,8,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource PriceNoteItem}">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                </ListBox>
            </Grid>

            <Grid Grid.Row="2" Margin="0,6,0,0">
                <Border BorderBrush="#654034" BorderThickness="1" CornerRadius="14" Background="#29120E" Padding="10" ClipToBounds="True">
                    <ListBox x:Name="TicketListBox"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="2,0,4,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="False"
                             ItemContainerStyle="{StaticResource TicketCardItem}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="116"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" CornerRadius="10" Background="#210E0B" BorderBrush="#5E3C31" BorderThickness="1" ClipToBounds="True" Margin="0,0,14,0">
                                        <Grid>
                                            <Image Source="{Binding ThumbnailPath}" Stretch="Uniform" Margin="4"/>
                                            <Border Background="#A82B1711" Visibility="Collapsed" x:Name="MissingArtwork">
                                                <TextBlock Text="找不到票面美術" Foreground="#D7B89A" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="12"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Ticket.DisplayName}"
                                                   FontFamily="Microsoft JhengHei UI"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="#FFF0CF"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Margin="0,10,0,0" Foreground="#E8C39A" FontSize="14">
                                            <Run Text="面額 $"/><Run Text="{Binding Ticket.Price, StringFormat={}{0:N0}}"/>
                                        </TextBlock>
                                        <TextBlock Margin="0,6,0,0" Foreground="#C79E79" FontSize="14">
                                            <Run Text="發行批次 "/><Run Text="{Binding BatchText}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="發行中獎率" Foreground="#D1A785" FontSize="12" HorizontalAlignment="Right"/>
                                        <TextBlock Margin="0,8,0,0" Text="{Binding Ticket.PublishedWinRate, StringFormat={}{0:P2}}" Foreground="#FFD363" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </StackPanel>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding ThumbnailPath}" Value="{x:Null}">
                                            <Setter TargetName="MissingArtwork" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <TextBlock x:Name="EmptyTicketText"
                           Text="這個面額目前沒有仍有庫存的彩券"
                           Visibility="Collapsed"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#CDAE8E"
                           FontSize="17"/>
            </Grid>

            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="取消" Width="120" Margin="0" Style="{StaticResource DialogSecondaryButton}" Click="Cancel_OnClick"/>
                <Button Grid.Column="3" Content="開始刮獎" Width="160" Margin="0" Style="{StaticResource DialogButton}" IsDefault="True" Click="Start_OnClick"/>
            </Grid>
        </Grid>
    </Border>
</Window>
