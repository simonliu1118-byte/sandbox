<Window x:Class="ScratchGame.Views.NewTicketDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="挑選彩券"
        Width="1000" Height="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="PriceNoteItem" TargetType="ListBoxItem">
            <Setter Property="Width" Value="104"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="IsEnabled" Value="{Binding HasTickets}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Note"
                                Background="#4A2B21"
                                BorderBrush="#8A5C3B"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="7">
                            <Grid ClipToBounds="True">
                                <Ellipse Width="33" Height="33" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="#573B231B" Stroke="#8F75573C" StrokeThickness="1"/>
                                <Rectangle Height="1" Margin="34,0,3,12" VerticalAlignment="Center" Fill="#805B4939"/>
                                <Rectangle Height="1" Margin="34,12,3,0" VerticalAlignment="Center" Fill="#805B4939"/>
                                <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="Bold" Foreground="#FFE3A3" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Note" Property="Background" Value="#8D3A2116"/>
                                <Setter TargetName="Note" Property="BorderBrush" Value="#FFD36B"/>
                                <Setter TargetName="Note" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Note" Property="Background" Value="#69403126"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Note" Property="Opacity" Value="0.32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TicketChoiceItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card"
                                Background="#C9311D17"
                                BorderBrush="#88614134"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="14">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#F1B94E"/>
                                <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Card" Property="Background" Value="#D33C2118"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#D641241B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="22" BorderBrush="#B87B40" BorderThickness="1" Background="#2A120E" SnapsToDevicePixels="True">
        <Grid>
            <Image x:Name="DialogBackgroundImage" Stretch="Fill" Opacity="0.92"/>
            <Grid Margin="36,32,36,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="挑選彩券" FontSize="30" FontWeight="Bold" Foreground="#FFE6A6"/>
                    <TextBlock Text="選一張喜歡的票，開始今天的手氣。" Margin="1,5,0,0" Foreground="#D8B392" FontSize="13"/>
                </StackPanel>

                <Border Grid.Row="1" Margin="0,20,0,16" Background="#8A241713" BorderBrush="#73534235" BorderThickness="1" CornerRadius="12" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="面額" VerticalAlignment="Center" FontSize="15" Foreground="#F4D9B0" Margin="2,0,12,0"/>
                        <ListBox x:Name="PriceFilterListBox"
                                 Grid.Column="1"
                                 SelectionChanged="PriceFilterListBox_OnSelectionChanged"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource PriceNoteItem}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <ListBox x:Name="TicketListBox"
                             BorderThickness="0"
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ItemContainerStyle="{StaticResource TicketChoiceItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="214" Height="130" Background="#24110D" CornerRadius="10" ClipToBounds="True">
                                        <Image Source="{Binding ThumbnailPath, Mode=OneWay}" Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="18,8,16,8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Ticket.DisplayName, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="#FFF0CF"/>
                                        <TextBlock Margin="0,8,0,0" Foreground="#D2AE8E" FontSize="14">
                                            <Run Text="面額 $"/><Run Text="{Binding Ticket.Price, Mode=OneWay, StringFormat={}{0:N0}}"/>
                                        </TextBlock>
                                        <TextBlock Margin="0,6,0,0" Text="發行批次" Foreground="#B99676" FontSize="13"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0">
                                        <TextBlock Text="發行中獎率" HorizontalAlignment="Right" Foreground="#B99376" FontSize="12"/>
                                        <TextBlock Text="{Binding Ticket.PublishedWinRate, Mode=OneWay, StringFormat={}{0:P2}}" FontSize="25" FontWeight="Bold" Foreground="#FFD363" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyTicketText"
                               Text="這個面額目前沒有啟用中的彩券"
                               Visibility="Collapsed"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#CDAE8E"
                               FontSize="17"/>
                </Grid>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="取消" Width="110" Style="{StaticResource DialogSecondaryButton}" Click="Cancel_OnClick"/>
                    <Button Content="開始刮獎" Width="150" Style="{StaticResource DialogButton}" IsDefault="True" Click="Start_OnClick"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
