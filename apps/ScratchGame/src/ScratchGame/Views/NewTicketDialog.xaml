<Window x:Class="ScratchGame.Views.NewTicketDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="挑選彩券"
        Width="1060" Height="760"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Background" Value="#21100D"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Width="13" Background="#21100D" CornerRadius="7" Padding="3,2">
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" Opacity="0"/></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb Cursor="Hand" MinHeight="34"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#AA7136" BorderBrush="#E4B35E" BorderThickness="1" CornerRadius="5"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" Opacity="0"/></Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact denomination chips: the controls use less vertical space while the actual
             price text is larger than Build 4. The old standalone "面額" label is intentionally gone. -->
        <Style x:Key="PriceNoteItem" TargetType="ListBoxItem">
            <Setter Property="Width" Value="105"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="IsEnabled" Value="{Binding HasTickets}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="SelectionChrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="10" Padding="2" Margin="1">
                            <Border x:Name="Note" CornerRadius="7" BorderBrush="{Binding BorderBrush}" BorderThickness="1" Background="{Binding Background}">
                                <Grid Margin="5,2">
                                    <Ellipse Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{Binding Background}" Stroke="{Binding Accent}" StrokeThickness="1"/>
                                    <TextBlock Text="✦" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,-2,0,0" Foreground="{Binding Accent}" FontSize="7"/>
                                    <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Foreground}" FontFamily="Microsoft JhengHei UI" FontWeight="SemiBold" FontSize="16.5"/>
                                </Grid>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionChrome" Property="BorderBrush" Value="#FFD66A"/>
                                <Setter TargetName="SelectionChrome" Property="Background" Value="#26F2B54C"/>
                                <Setter TargetName="Note" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectionChrome" Property="Background" Value="#18FFFFFF"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SelectionChrome" Property="Opacity" Value="0.28"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Five cards fit per row. Two rows use 520px including margins, leaving layout-rounding
             headroom inside the 528px card viewport so ten cards do not spuriously show a scrollbar. -->
        <Style x:Key="TicketCardItem" TargetType="ListBoxItem">
            <Setter Property="Width" Value="182"/>
            <Setter Property="Height" Value="252"/>
            <Setter Property="Margin" Value="5,4"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card"
                                Background="#563F39"
                                BorderBrush="#80584A"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#654841"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="#C38B4B"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#654B44"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="#FFD052"/>
                                <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="22" BorderBrush="#B87B40" BorderThickness="1.4" Background="#351610" SnapsToDevicePixels="True">
        <Grid Margin="30,24,30,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="58"/>
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="挑選彩券" FontFamily="Microsoft JhengHei UI" FontSize="30" FontWeight="Bold" Foreground="#FFE6A6"/>
                <TextBlock Text="選一張喜歡的彩券，開始今天的手氣。" Margin="1,4,0,0" Foreground="#D8B392" FontSize="13"/>
            </StackPanel>

            <ListBox x:Name="PriceFilterListBox"
                     Grid.Row="1"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     SelectionChanged="PriceFilterListBox_OnSelectionChanged"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource PriceNoteItem}">
                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
            </ListBox>

            <Grid Grid.Row="2" Margin="0,2,0,0">
                <Border BorderBrush="#654034" BorderThickness="1" CornerRadius="14" Background="#29120E" Padding="8" ClipToBounds="True">
                    <ListBox x:Name="TicketListBox"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="False"
                             ItemContainerStyle="{StaticResource TicketCardItem}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <!-- Required card order: name, price, thumbnail, max prize, win rate, date/batch. -->
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="22"/>
                                        <RowDefinition Height="121"/>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="14"/>
                                        <RowDefinition Height="21"/>
                                        <RowDefinition Height="18"/>
                                    </Grid.RowDefinitions>

                                    <!-- Never use ellipsis for ticket names. Wrap first; only scale down when
                                         the complete wrapped name cannot fit the reserved name area. -->
                                    <Viewbox Grid.Row="0"
                                             Margin="2,0"
                                             Stretch="Uniform"
                                             StretchDirection="DownOnly"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Ticket.DisplayName}"
                                                   Width="166"
                                                   FontFamily="Microsoft JhengHei UI"
                                                   FontSize="14.5"
                                                   FontWeight="Bold"
                                                   Foreground="#FFF2D3"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                    </Viewbox>

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding PriceText}"
                                               FontFamily="Microsoft JhengHei UI"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#FFD66F"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <Border Grid.Row="2"
                                            Margin="2"
                                            CornerRadius="8"
                                            Background="#210E0B"
                                            BorderBrush="#5E3C31"
                                            BorderThickness="1"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding ThumbnailPath}" Stretch="Uniform" Margin="3"/>
                                            <Border Background="#A82B1711" Visibility="Collapsed" x:Name="MissingArtwork">
                                                <TextBlock Text="找不到票面美術"
                                                           Foreground="#D7B89A"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           FontSize="10"
                                                           Margin="7"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Viewbox Grid.Row="3"
                                             Margin="2,0"
                                             Stretch="Uniform"
                                             StretchDirection="DownOnly"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MaxPrizeText}"
                                                   Width="166"
                                                   FontFamily="Microsoft JhengHei UI"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFE0A0"
                                                   TextAlignment="Center"/>
                                    </Viewbox>

                                    <TextBlock Grid.Row="4"
                                               Text="中獎率"
                                               FontFamily="Microsoft JhengHei UI"
                                               Foreground="#D1AE91"
                                               FontSize="9.5"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Bottom"/>

                                    <TextBlock Grid.Row="5"
                                               Text="{Binding WinRateText}"
                                               FontFamily="Microsoft JhengHei UI"
                                               Foreground="#FFD45E"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="6"
                                               Text="{Binding BatchText}"
                                               FontFamily="Microsoft JhengHei UI"
                                               FontSize="9.5"
                                               Foreground="#D4B79E"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding ThumbnailPath}" Value="{x:Null}">
                                        <Setter TargetName="MissingArtwork" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <TextBlock x:Name="EmptyTicketText"
                           Text="這個面額目前沒有仍有庫存的彩券"
                           Visibility="Collapsed"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#CDAE8E"
                           FontSize="17"/>
            </Grid>

            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="取消" Width="120" Margin="0" Style="{StaticResource DialogSecondaryButton}" Click="Cancel_OnClick"/>
                <Button Grid.Column="3" Content="開始刮獎" Width="160" Margin="0" Style="{StaticResource DialogButton}" IsDefault="True" Click="Start_OnClick"/>
            </Grid>
        </Grid>
    </Border>
</Window>
