<Window x:Class="ScratchGame.Views.PlayStatsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="遊玩紀錄"
        Width="1280" Height="900"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        Opacity="0"
        Loaded="Window_OnLoaded"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Background="Transparent">
        <Border x:Name="DimLayer" Background="#72000000" Opacity="0"/>

        <Grid x:Name="ScrollCard"
              Width="680"
              Height="560"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Opacity="0"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ScrollScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="ScrollTranslate" X="0" Y="0"/>
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- Shadow is isolated from text so ClearType content remains crisp. -->
            <Border Margin="22,24"
                    CornerRadius="20"
                    Background="#351610"
                    BorderBrush="#D59B48"
                    BorderThickness="2"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect Color="#160704" BlurRadius="26" ShadowDepth="8" Opacity="0.55"/>
                </Border.Effect>
            </Border>

            <Border Margin="22,24"
                    CornerRadius="20"
                    BorderBrush="#D59B48"
                    BorderThickness="2"
                    Padding="30,25,30,22">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4A2018" Offset="0"/>
                        <GradientStop Color="#351610" Offset="0.50"/>
                        <GradientStop Color="#2A100C" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="66"/>
                        <RowDefinition Height="92"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="60"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="遊玩紀錄"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               FontFamily="Microsoft JhengHei UI"
                               FontSize="29"
                               FontWeight="Bold"
                               Foreground="#FFE6A6"/>

                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="UserNameText"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   FontFamily="Microsoft JhengHei UI"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#F5DDB7"/>
                        <TextBlock x:Name="WalletText"
                                   Margin="0,7,0,0"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   FontFamily="Microsoft JhengHei UI"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#FFD46C"/>
                    </StackPanel>

                    <Border Grid.Row="2"
                            Margin="0,4,0,0"
                            BorderBrush="#815A3D"
                            BorderThickness="0,1,0,1"
                            Padding="10,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="累計刮卡" VerticalAlignment="Center" Foreground="#C4A287" FontSize="15"/>
                            <TextBlock x:Name="CompletedText" Grid.Column="1" VerticalAlignment="Center" Foreground="#F6DFC0" FontSize="18" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="1" Text="中獎張數" VerticalAlignment="Center" Foreground="#C4A287" FontSize="15"/>
                            <TextBlock x:Name="WinCountText" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Foreground="#F6DFC0" FontSize="18" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="2" Text="勝率" VerticalAlignment="Center" Foreground="#C4A287" FontSize="15"/>
                            <TextBlock x:Name="WinRateText" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Foreground="#F6DFC0" FontSize="18" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="3" Text="最大獎金" VerticalAlignment="Center" Foreground="#C4A287" FontSize="15"/>
                            <TextBlock x:Name="MaxPrizeText" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Foreground="#FFE098" FontSize="18" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="4" Text="累計投入" VerticalAlignment="Center" Foreground="#C4A287" FontSize="15"/>
                            <TextBlock x:Name="TotalSpentText" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Foreground="#E6D0B8" FontSize="17"/>

                            <TextBlock Grid.Row="5" Text="累計中獎" VerticalAlignment="Center" Foreground="#C4A287" FontSize="15"/>
                            <TextBlock x:Name="TotalRedeemedText" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" Foreground="#E6D0B8" FontSize="17"/>

                            <TextBlock Grid.Row="6" Text="總損益" VerticalAlignment="Center" Foreground="#C4A287" FontSize="15"/>
                            <TextBlock x:Name="NetText" Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" Foreground="#FFD46C" FontSize="18" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="7" Text="資金補充" VerticalAlignment="Center" Foreground="#C4A287" FontSize="15"/>
                            <TextBlock x:Name="GrantText" Grid.Row="7" Grid.Column="1" VerticalAlignment="Center" Foreground="#E6D0B8" FontSize="16"/>
                        </Grid>
                    </Border>

                    <Button Grid.Row="3"
                            Content="關閉"
                            Width="108"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource DialogButton}"
                            IsDefault="True"
                            Click="Close_OnClick"/>
                </Grid>
            </Border>

            <Border Height="34"
                    Margin="8,8,8,0"
                    VerticalAlignment="Top"
                    CornerRadius="17"
                    BorderBrush="#E0AA57"
                    BorderThickness="1.5"
                    IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#7B4A28" Offset="0"/>
                        <GradientStop Color="#4D271B" Offset="0.5"/>
                        <GradientStop Color="#6D3D22" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Border Height="34"
                    Margin="8,0,8,8"
                    VerticalAlignment="Bottom"
                    CornerRadius="17"
                    BorderBrush="#E0AA57"
                    BorderThickness="1.5"
                    IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#6D3D22" Offset="0"/>
                        <GradientStop Color="#4D271B" Offset="0.5"/>
                        <GradientStop Color="#7B4A28" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>
    </Grid>
</Window>