<Window x:Class="PackEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScratchPack Editor"
        Width="1500" Height="940"
        MinWidth="1280" MinHeight="820"
        WindowStartupLocation="CenterScreen"
        Background="#1C100D"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#321713" BorderBrush="#8B5E35" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PackEditor" FontFamily="Segoe UI" FontSize="24" FontWeight="Bold" Foreground="#FFD981" VerticalAlignment="Center"/>
                    <TextBlock Text="  ScratchPack Editor" FontFamily="Microsoft JhengHei UI" FontSize="14" Foreground="#B99376" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="新增 Pack" Style="{StaticResource ToolbarButton}" Click="NewPack_OnClick"/>
                    <Button Content="開啟" Style="{StaticResource ToolbarButton}" IsEnabled="False"/>
                    <Button Content="儲存" Style="{StaticResource ToolbarButton}" IsEnabled="False"/>
                    <Button Content="輸出 .scratchpack" Style="{StaticResource ToolbarButton}" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#281410" BorderBrush="#654232" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,16,0,0">
                    <TextBlock Text="編輯項目" Margin="16,0,0,8" FontFamily="Microsoft JhengHei UI" FontSize="12" Foreground="#A8836D"/>
                    <Button Content="基本資料" Style="{StaticResource NavButton}"/>
                    <Button Content="票面素材" Style="{StaticResource NavButton}"/>
                    <Button Content="遊戲區域" Style="{StaticResource NavButton}"/>
                    <Button Content="獎金池" Style="{StaticResource NavButton}"/>
                    <Button Content="驗證與輸出" Style="{StaticResource NavButton}"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="22,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="4,0,4,12">
                    <TextBlock Text="彩券即時預覽" FontFamily="Microsoft JhengHei UI" FontSize="20" FontWeight="Bold" Foreground="#FFE2A0"/>
                    <TextBlock Text="1080 × 882" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontFamily="Segoe UI" FontSize="12" Foreground="#9E7E69"/>
                </Grid>

                <Border Grid.Row="1" Background="#140B09" BorderBrush="#6A4838" BorderThickness="1" CornerRadius="12" Padding="20">
                    <Viewbox Stretch="Uniform">
                        <Grid Width="1080" Height="882" Background="#F3E8D5">
                            <Border BorderBrush="#A77B49" BorderThickness="4"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="ScratchPack 預覽" FontFamily="Microsoft JhengHei UI" FontSize="42" FontWeight="Bold" Foreground="#5A3527" HorizontalAlignment="Center"/>
                                <TextBlock Text="建立 Pack 後，票面／Scratch Zone／面額／票號會在此即時疊圖。" Margin="0,18,0,0" FontFamily="Microsoft JhengHei UI" FontSize="21" Foreground="#80604D" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Viewbox>
                </Border>
            </Grid>

            <Border Grid.Column="2" Background="#24120F" BorderBrush="#654232" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,18">
                        <TextBlock Text="基本資料" FontFamily="Microsoft JhengHei UI" FontSize="20" FontWeight="Bold" Foreground="#FFE2A0"/>

                        <TextBlock Text="彩券名稱" Margin="0,18,0,5" Foreground="#C7A58B" FontSize="13"/>
                        <TextBox x:Name="PackNameTextBox" Height="36" Padding="9,5" FontFamily="Microsoft JhengHei UI" FontSize="14"/>

                        <TextBlock Text="GameType" Margin="0,14,0,5" Foreground="#C7A58B" FontSize="13"/>
                        <ComboBox x:Name="GameTypeComboBox" Height="36" SelectedIndex="0">
                            <ComboBoxItem Content="GameType 1"/>
                        </ComboBox>

                        <TextBlock Text="面額" Margin="0,14,0,5" Foreground="#C7A58B" FontSize="13"/>
                        <TextBox x:Name="PriceTextBox" Height="36" Text="500" Padding="9,5"/>

                        <TextBlock Text="Package ID" Margin="0,14,0,5" Foreground="#C7A58B" FontSize="13"/>
                        <TextBox x:Name="PackageIdTextBox" Height="36" IsReadOnly="True" Padding="9,5" FontFamily="Consolas" FontSize="12"/>
                        <TextBlock Text="由 PackEditor 使用 UUID v4 自動產生；同一 Pack 儲存時維持不變。" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#90715E" FontSize="11"/>

                        <Border Margin="0,22,0,0" BorderBrush="#6A4838" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="獎金池摘要" FontFamily="Microsoft JhengHei UI" FontSize="16" FontWeight="SemiBold" Foreground="#F0D2A1"/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="中獎率" Foreground="#B99376"/>
                                    <TextBlock Grid.Column="1" Text="—" Foreground="#F5DEC0"/>
                                    <TextBlock Grid.Row="1" Text="平均獎金（期望值）" Foreground="#B99376"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="—" Foreground="#F5DEC0"/>
                                    <TextBlock Grid.Row="2" Text="獎金回饋率" Foreground="#B99376"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="—" Foreground="#FFD46C" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#2B1612" BorderBrush="#654232" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <TextBlock x:Name="StatusText" Text="尚未建立 Pack" VerticalAlignment="Center" FontFamily="Microsoft JhengHei UI" FontSize="12" Foreground="#C5A083"/>
                <TextBlock Text="ScratchPack V1" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="11" Foreground="#8F715E"/>
            </Grid>
        </Border>
    </Grid>
</Window>
